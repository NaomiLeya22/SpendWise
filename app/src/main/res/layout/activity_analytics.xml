<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/analyticsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Financial Reports &amp; Analytics"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/monthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="October 2026"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:paddingBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/incomeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total income: ZMW 0.00"
                        android:textSize="16sp"
                        android:textColor="@android:color/holo_green_dark" />

                    <TextView
                        android:id="@+id/expenseValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total expenses: ZMW 0.00"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/holo_red_dark" />

                    <TextView
                        android:id="@+id/balanceValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Balance: ZMW 0.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/black" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/categoryBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expenses by Category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/categoryPieChart"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportReportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPORT PDF REPORT"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
