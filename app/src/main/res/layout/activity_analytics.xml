<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/analyticsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly Analytics"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/monthLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="October 2026"
            android:textSize="18sp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/incomeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Income: K0.00"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/expenseValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expenses: K0.00"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/balanceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Balance: K0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <TextView
            android:id="@+id/categoryBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expenses by category"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/budgetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Budget status"
            android:textSize="16sp"
            android:padding="12dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/categoryPieChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/exportReportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export PDF Report"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
